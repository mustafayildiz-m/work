# Database Configuration
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=islamic_windows
MYSQL_USER=islamic_user
MYSQL_PASSWORD=islamic_pass
MYSQL_PORT=3315

# Backend Configuration
NODE_ENV=production
BACKEND_PORT=3000
JWT_SECRET=your-secret-key-change-in-production

# Redis Configuration
REDIS_PORT=6379

# Frontend Ports
ADMIN_FRONT_PORT=5173
USER_FRONT_PORT=3001

# Frontend URLs (for production)
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:5173

# Mail Configuration (docker-compose.prod.yml bu degerleri backend container'ina gecer)
# MAIL_PASS: Gmail app password, 16 hane, bosluksuz
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
