{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      "mail/templates/**/*",
      {
        "include": "qa/data/**/*.json",
        "outDir": "dist",
        "watchAssets": true
      },
      {
        "include": "documents/**/*.json",
        "outDir": "dist",
        "watchAssets": true
      }
    ],
    "watchAssets": true
  }
}
