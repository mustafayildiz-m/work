# backend/.env.example - kopyalayip backend/.env olarak doldurun (git'e commit ETMEYIN).
# MAIL_PASS: Gmail hesabinin 16 haneli app password'u (bosluksuz).

DB_HOST=localhost
DB_PORT=3315
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=islamic_windows
JWT_SECRET=

DB_LIVE_USERNAME=
DB_LIVE_PASSPORT=



# PDF Parser Configuration
PARSER_MIN_NAME_LENGTH=3
PARSER_MAX_NAME_LENGTH=120
PARSER_MIN_WORD_COUNT=2
PARSER_MAX_WORD_COUNT=10
PARSER_ALT_NAME_SUPPORT=true
PARSER_CONFIDENCE_THRESHOLD=40

# File Handling
UPLOADS_DIR=./uploads
MAX_PDF_SIZE_MB=50

# Queue Configuration (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379


DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate

# Google OAuth (backend verifies id_token)
GOOGLE_CLIENT_ID=

# Mail Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
FRONTEND_URL=https://islamicwindows.com
